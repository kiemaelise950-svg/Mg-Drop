        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor #F5FEFF\nskinparam component {\n  BackgroundColor #AAC0E1\n  BorderColor #0E2F76\n  FontColor #0E2F76\n}\nskinparam node {\n  BackgroundColor #F5FEFF\n  BorderColor #0E2F76\n  FontColor #0E2F76\n}\nskinparam interface {\n  BackgroundColor #0E2F76\n  BorderColor #0E2F76\n}\nskinparam arrowColor #0E2F76\nskinparam note {\n  BackgroundColor #F5FEFF\n  BorderColor #0E2F76\n}\n\nnode \&quot;Matériel : Tecno Camon (Client)\&quot; {\n  component \&quot;Application Modeste Graphics\\n(Flutter / Android)\&quot; as AppAndroid {\n    [Intercepteur de Partage\\n(receive_sharing_intent)] as ShareIntent\n    [Module UI/UX\\n(Bottom Sheet &amp; Dynamic Port)] as UIAndroid\n    [Gestionnaire NFC\\n(nfc_manager)] as NFCManager\n    [Client TCP\\n(Socket / Wi-Fi)] as TCPClient\n  }\n  interface \&quot;Capteur NFC\\n(Matériel)\&quot; as HardwareNFCAndroid\n  interface \&quot;Carte Wi-Fi\\n(Matériel)\&quot; as WifiAndroid\n  \n  ShareIntent --&gt; UIAndroid : 1. Déclenche l&#39;UI\n  UIAndroid --&gt; NFCManager : 2. Active l&#39;écoute\n  NFCManager ..&gt; HardwareNFCAndroid : Lit le tag NDEF\n  TCPClient ..&gt; WifiAndroid : Envoie le fichier\n}\n\nnode \&quot;Matériel : Dell Latitude (Serveur)\&quot; {\n  component \&quot;Service Modeste Graphics\\n(C# WPF / Windows)\&quot; as AppWindows {\n    [Service d&#39;Arrière-plan\\n(System Tray)] as BackgroundService\n    [Contrôleur NFC\\n(Proximity API)] as NFCProximity\n    [Écouteur TCP\\n(TcpListener Port 8080)] as TCPListener\n    [Système de Fichiers\\n(Dossier Téléchargements)] as FileManager\n    [Overlay WPF\\n(Fenêtre sans bordure)] as UIWindows\n  }\n  interface \&quot;Pilote Proximity Provider\\n(Matériel)\&quot; as HardwareNFCWindows\n  interface \&quot;Carte Wi-Fi\\n(Matériel)\&quot; as WifiWindows\n  \n  BackgroundService --&gt; NFCProximity : 1. Configure l&#39;IP\n  BackgroundService --&gt; TCPListener : 2. Ouvre le port\n  NFCProximity ..&gt; HardwareNFCWindows : Diffuse le signal\n  WifiWindows ..&gt; TCPListener : Reçoit les données\n  TCPListener --&gt; FileManager : 3. Sauvegarde\n  FileManager --&gt; UIWindows : 4. Invoque la carte\n}\n\ncloud \&quot;Réseau Local (Wi-Fi)\&quot; as LocalNetwork\n\nHardwareNFCWindows &lt;..&gt; HardwareNFCAndroid : Contact Physique (Handshake)\nWifiAndroid --&gt; LocalNetwork : Flux binaire\nLocalNetwork --&gt; WifiWindows : Flux binaire\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mlQdYnRGOc0fhGw4Xrnx-1">
